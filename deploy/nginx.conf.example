# CYINC 生产 Nginx — 整站同域（Vue /myweb/ + API + Admin + uploads）
# 复制到 /etc/nginx/sites-available/cyinc

upstream cyinc_api {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # certbot --nginx -d yourdomain.com -d www.yourdomain.com

    client_max_body_size 16m;

    # FastAPI API
    location /api {
        proxy_pass http://cyinc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # SQLAdmin
    location /admin {
        proxy_pass http://cyinc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # 用户头像等上传文件（FastAPI StaticFiles）
    location /uploads {
        proxy_pass http://cyinc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # Vue 静态站（Vite base=/myweb/）
    # 构建：npm run build → 将 docs/ 同步到 /var/www/cyinc/myweb/
    location /myweb/ {
        root /var/www/cyinc;
        try_files $uri $uri/ /myweb/index.html;
    }

    location = /myweb {
        return 301 /myweb/;
    }

    location = / {
        return 301 /myweb/;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 256;
}
