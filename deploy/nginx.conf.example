# CYINC 生产 Nginx — 整站同域（Vue /myweb/ + API + Admin + uploads）
# 复制到 /etc/nginx/sites-available/cyinc

upstream cyinc_api {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # certbot --nginx -d yourdomain.com -d www.yourdomain.com

    client_max_body_size 16m;

    # 静态文件打开缓存（大图站很有用，减轻磁盘 IO）
    open_file_cache max=2000 inactive=60s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;

    # FastAPI API
    location /api {
        proxy_pass http://cyinc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # SQLAdmin
    location /admin {
        proxy_pass http://cyinc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # 用户头像等上传文件（FastAPI StaticFiles）— 浏览器可缓存一天
    location /uploads {
        proxy_pass http://cyinc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # 博客文章正文（运行时数据，住在 site-data/，与前端部署隔离）
    location ^~ /myweb/Content/ {
        alias /var/www/cyinc/site-data/Content/;
        try_files $uri =404;
    }

    # 文章目录 posts.json（运行时数据，同样住在 site-data/）
    location = /myweb/data/posts.json {
        alias /var/www/cyinc/site-data/data/posts.json;
        add_header Cache-Control "no-store";
    }

    # Vite hashed assets — 文件名带 hash，可长期缓存
    location ^~ /myweb/assets/ {
        root /var/www/cyinc;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # 大图 / 音乐 — 与前端包分离，Nginx 直出（部署快、可长期缓存）
    location ^~ /myweb/img/ {
        alias /var/www/cyinc/img/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location ^~ /myweb/Music/ {
        alias /var/www/cyinc/Music/;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Accept-Ranges bytes;
        types {
            audio/flac flac;
            audio/mpeg mp3;
            audio/ogg ogg;
            image/jpeg jpg jpeg;
            image/png png;
        }
        access_log off;
    }

    # Vue 静态站（Vite base=/myweb/）— 仅含 index.html + assets + Content
    # 构建：npm run build → deploy/scripts/pack-frontend.ps1 → 上传 frontend.zip 到 myweb/ 解压
    # 必须包含 Content/（文章正文）与 assets/
    location /myweb/ {
        root /var/www/cyinc;
        try_files $uri $uri/ /myweb/index.html;
    }

    location = /myweb {
        return 301 /myweb/;
    }

    location = / {
        return 301 /myweb/;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 256;
}
