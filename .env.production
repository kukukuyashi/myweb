# 生产环境构建用（vite build 自动加载，可提交 Git）
# Twikoo envId 会出现在前端代码中，不是密钥
VITE_TWIKOO_ENV_ID=https://cyinc-twikoo.netlify.app/.netlify/functions/twikoo

# 音乐 CDN 根地址（末尾不要 /）。留空则构建时复制 Music/ 到 docs/
# 线上可在 GitHub Actions 变量 VITE_MUSIC_BASE_URL 覆盖
# VITE_MUSIC_BASE_URL=

# 与 ECS Nginx 同域，使用相对路径（避免打进 localhost:8000）
VITE_API_BASE_URL=/api/v1
