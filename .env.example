# 复制为 .env.local 后填写（.env.local 不会提交到 Git）

# Twikoo 留言板：https://twikoo.js.org/quick-start.html
# 线上 Netlify 地址（envId 会出现在前端代码中，非密钥）
VITE_TWIKOO_ENV_ID=https://cyinc-twikoo.netlify.app/.netlify/functions/twikoo

# 音乐 CDN 公开根地址（末尾不要 /）。留空则使用同域 /myweb/Music/
VITE_MUSIC_BASE_URL=

# ECS 生产：0 = img/Music 由 Nginx 提供（推荐）；GitHub Pages：1 = 打进 dist
# VITE_BUNDLE_STATIC_MEDIA=0

# CYINC Platform API（FastAPI 本地联调）
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- 上传 Music/ 到对象存储（npm run music:upload，仅本地执行）---
# S3 兼容：Cloudflare R2 / 阿里云 OSS（S3 协议）/ AWS S3
CDN_S3_BUCKET=your-bucket
CDN_S3_ACCESS_KEY_ID=
CDN_S3_SECRET_ACCESS_KEY=
# R2: https://<accountid>.r2.cloudflarestorage.com
# 阿里云 OSS: https://oss-cn-hangzhou.aliyuncs.com
CDN_S3_ENDPOINT=
CDN_S3_REGION=auto
# 可选：对象键前缀（默认直接 Music/...）
# CDN_S3_PREFIX=
# 部分 OSS 需开启：CDN_S3_FORCE_PATH_STYLE=1
