# 复制为 .env.local 后填写（.env.local 不会提交到 Git）

# Twikoo 留言板：https://twikoo.js.org/quick-start.html
# 线上 Netlify 地址（envId 会出现在前端代码中，非密钥）
VITE_TWIKOO_ENV_ID=https://cyinc-twikoo.netlify.app/.netlify/functions/twikoo

# 音乐 CDN 根地址（末尾不要 /）。留空则使用本地 /Music/ 路径（仅 phpStudy 可用）
# 例：https://your-bucket.oss-cn-hangzhou.aliyuncs.com/music
VITE_MUSIC_BASE_URL=
