{
  "name": "gerenboke",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/dev.ps1",
    "cursors:generate": "python scripts/generate-cursors.py",
    "build": "node scripts/export-posts-json.mjs && node scripts/generate-about-gallery.mjs && node scripts/generate-music-tracks.mjs && python scripts/generate-cursors.py && vite build --base /myweb/ && node scripts/generate-site-files.mjs docs && node scripts/generate-prerender.mjs docs",
    "build:local": "vite build --base /gerenboke/docs/",
    "preview": "vite preview --base /myweb/",
    "music:upload": "node scripts/upload-music-cdn.mjs",
    "new:post": "node scripts/new-post.mjs",
    "publish:post": "node scripts/publish-post.mjs",
    "admin": "npm run dev"
  },
  "dependencies": {
    "dompurify": "^3.4.10",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/lib-storage": "^3.888.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
