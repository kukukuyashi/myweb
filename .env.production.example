# ECS 整站同域构建 — 复制为 .env.production（不提交 Git）
# npm run build 会自动读取 .env.production

# 与 ECS Nginx 同域，使用相对路径（无需写域名）
VITE_API_BASE_URL=/api/v1

VITE_TWIKOO_ENV_ID=https://cyinc-twikoo.netlify.app/.netlify/functions/twikoo

# 音乐：留空 = 同域 /myweb/Music/（Nginx alias 到 /var/www/cyinc/Music/）
# 若用对象存储 CDN，填公开根地址（末尾不要 /）
VITE_MUSIC_BASE_URL=

# ECS 推荐 0：img/ 与 Music/ 由 Nginx 提供，前端 zip 更小、上传更快
# GitHub Pages 静态站请设为 1，会把 img/Music 打进 docs/
VITE_BUNDLE_STATIC_MEDIA=0
