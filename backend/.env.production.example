# 生产环境示例 — 复制到 ECS 上 backend/.env，勿提交 Git

# 阿里云 RDS（须替换为控制台「内网地址」，勿保留 rm-xxxxx 占位符）
# 密码仅用英文字母与数字，避免中文导致 pymysql latin-1 编码错误
# RDS 白名单须包含 ECS 内网 IP
DATABASE_URL=mysql+pymysql://cyinc:ChangeMeAsciiOnly@rm-bp1xxxxxxxx.mysql.rds.aliyuncs.com:3306/cyinc

# ECS 本机 MySQL（Docker 容器访问宿主机，Linux 用下面之一）：
# DATABASE_URL=mysql+pymysql://cyinc:强密码@host.docker.internal:3306/cyinc
#   需 docker-compose.prod.yml 里 extra_hosts: host.docker.internal:host-gateway
# 或直接用 docker0 网关（常见 172.17.0.1），且 MySQL bind-address 不能仅 127.0.0.1：
# DATABASE_URL=mysql+pymysql://cyinc:强密码@172.17.0.1:3306/cyinc

SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_PREFIX=/api/v1

# 整站同域（仅填你的域名）
CORS_ORIGINS=https://yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com/myweb
# Nginx 已上 HTTPS 时务必开启（防止 /admin 生成 http:// 链接）
FORCE_HTTPS=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=uploads

DIFY_API_URL=https://api.dify.ai/v1
DIFY_SUMMARY_API_KEY=
DIFY_CHAT_API_KEY=
DIFY_TIMEOUT_SEC=60

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SEC=10

# QQ 邮箱 SMTP（注册验证码）— 密码填 QQ 邮箱「授权码」，不是 QQ 登录密码
# 获取：QQ 邮箱 → 设置 → 账户 → POP3/SMTP → 开启并生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=1344908013@qq.com
SMTP_PASSWORD=
SMTP_FROM=1344908013@qq.com
SMTP_USE_SSL=true

# 追番「去追番」外链（橘子动漫播放页）
MGNACG_BASE_URL=https://www.mgnacg.com
MGNACG_ENABLED=true

# ACG 资讯机器人（论坛每日资讯）
ACG_BOT_USERNAME=acg-bot
# 默认发布板块 slug（留空则自动分配 acg-daily / acg-news）
ACG_BOT_CATEGORY_SLUG=
# 逗号分隔的 RSS 源；留空使用内置默认源
ACG_RSS_FEEDS=
# 定时任务：cron 表达式（分 时 日 月 周，本地 Asia/Shanghai 时区），置空关闭
ACG_BOT_SCHEDULE_CRON=0 8 * * *
# 定时任务是否自动发布"每日速报"到 ACG每日速报 板块（深度文章始终仅入草稿等审核）
ACG_BOT_AUTO_PUBLISH_DAILY=true
