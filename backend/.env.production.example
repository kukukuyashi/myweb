# 生产环境示例 — 复制到 ECS 上 backend/.env，勿提交 Git

# 阿里云 RDS
DATABASE_URL=mysql+pymysql://cyinc:强密码@rm-xxxxx.mysql.rds.aliyuncs.com:3306/cyinc

SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_PREFIX=/api/v1

# 整站同域（仅填你的域名）
CORS_ORIGINS=https://yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com/myweb

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=uploads

DIFY_API_URL=https://api.dify.ai/v1
DIFY_SUMMARY_API_KEY=
DIFY_CHAT_API_KEY=
DIFY_TIMEOUT_SEC=60

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SEC=10
