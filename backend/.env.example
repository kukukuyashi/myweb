# 方案 A 环境变量示例（复制为 backend/.env）

DATABASE_URL=mysql+pymysql://Cyinc:你的密码@127.0.0.1:3306/cyinclog
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
API_PREFIX=/api/v1

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 笔记管理台（线上 /myweb/admin）路径；ECS 示例：
# NOTES_ROOT=/var/www/cyinc/笔记
# SITE_WEB_ROOT=/var/www/cyinc/myweb
NOTES_ROOT=
SITE_WEB_ROOT=
NOTES_ADMIN_TOKEN_EXPIRE_MINUTES=480

# Redis 可选（无 Docker 可留空）
REDIS_URL=

# Dify Cloud — 见 deploy/README-cloud-dev.md
DIFY_API_URL=https://api.dify.ai/v1
DIFY_SUMMARY_API_KEY=
DIFY_CHAT_API_KEY=
DIFY_TIMEOUT_SEC=60

# n8n Cloud — 见 deploy/README-cloud-dev.md
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SEC=10

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
PUBLIC_SITE_URL=http://127.0.0.1:5173/myweb

# ACG 资讯机器人（论坛每日资讯）
ACG_BOT_USERNAME=acg-bot
# 默认发布板块 slug（留空则用排序最前的板块）
ACG_BOT_CATEGORY_SLUG=
# 逗号分隔的 RSS 源；留空使用内置默认源
ACG_RSS_FEEDS=
# 定时任务 cron（分 时 日 月 周，本地时区），置空关闭
ACG_BOT_SCHEDULE_CRON=0 8 * * *
ACG_BOT_AUTO_PUBLISH_DAILY=true
