# 方案 A 环境变量示例（复制为 backend/.env）

DATABASE_URL=mysql+pymysql://Cyinc:你的密码@127.0.0.1:3306/cyinclog
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PREFIX=/api/v1

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Redis 可选（无 Docker 可留空）
REDIS_URL=

# Dify Cloud — 见 deploy/README-cloud-dev.md
DIFY_API_URL=https://api.dify.ai/v1
DIFY_SUMMARY_API_KEY=
DIFY_CHAT_API_KEY=
DIFY_TIMEOUT_SEC=60

# n8n Cloud — 见 deploy/README-cloud-dev.md
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SEC=10
PUBLIC_SITE_URL=http://127.0.0.1:5173/myweb
